# ---------------------------------------------------------------------------
# Nexora — environment configuration
#
# Copy to `.env.local` and fill in.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the JavaScript bundle and is
# readable by every visitor. Never put a secret, key or connection string there.
# ---------------------------------------------------------------------------

# === Required for the backend ==============================================

# Neon Postgres connection string (include ?sslmode=require).
# Create a database at https://neon.tech, then: npm run db:push && npm run db:seed
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/nexora?sslmode=require

# Encrypts TOTP secrets at rest. Generate with:  openssl rand -base64 32
# Rotating this invalidates every enrolled 2FA device — treat it as permanent.
ENCRYPTION_KEY=

# Absolute origin, used to build links inside emails.
APP_URL=http://localhost:3000


# === Client-visible flags ===================================================

# Points the frontend service layer at the backend.
# "/api" uses the route handlers in this app. Empty = pure mock build.
NEXT_PUBLIC_API_BASE_URL=/api

# Canonical URL for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only once MARKET_API_KEY below is set and working.
NEXT_PUBLIC_LIVE_MARKET_DATA=false

# ---------------------------------------------------------------------------
# DO NOT set either of the next two to "true" without the integration behind it.
#
# They control whether the interface tells users that deposits, withdrawals and
# trading are available. Enabling a flag does not implement the capability — it
# only stops the UI from saying the capability is missing. Turning one on early
# produces a site that invites deposits it cannot actually receive or return.
# ---------------------------------------------------------------------------

# Deposits, withdrawals and the ledger. Turn on only when an operator is
# genuinely monitoring /admin/deposits — in this model a deposit is credited by
# a person, and the interface promises the customer that it will be.
NEXT_PUBLIC_CUSTODY_ENABLED=false

# Requires custody plus a venue or liquidity arrangement.
NEXT_PUBLIC_TRADING_ENABLED=false


# === Optional providers =====================================================
# Each is optional. When absent, the related feature reports itself unavailable
# rather than pretending to work.

# Market data — CoinGecko. Demo keys start "CG-"; paid keys use the pro host.
MARKET_API_KEY=
MARKET_PROVIDER=coingecko

# --- Transactional email -----------------------------------------------------
# Configure ONE transport. Both are fully implemented.
# Without either, verification and reset links are NOT sent (printed to the
# server console in development only).
#
# Resend is preferred where both are set: HTTP survives hosts that block
# outbound SMTP ports, which is a common and confusing failure.
RESEND_API_KEY=
# Any SMTP provider (SES, Postmark, Mailgun, Sendgrid…)
SMTP_URL=
# Required once a transport is set. Must be a domain you have verified.
MAIL_FROM="Nexora <no-reply@example.com>"

# --- Wallet model ------------------------------------------------------------
# Which model the product runs. These are alternatives, not layers.
#
#   custodial      the platform holds keys via a custodian; balances come from
#                  the internal ledger. Needs a custody licence in most places.
#   non-custodial  the user holds keys; balances are read from chain. The
#                  platform cannot move funds and holds no key that could.
#
# This is a legal decision before it is a technical one. Confirm with counsel.
NEXT_PUBLIC_WALLET_MODEL=custodial

# Optional dedicated RPC endpoints for the non-custodial chain reader.
# Without these it falls back to viem's bundled public endpoints, which are
# rate limited and carry no uptime guarantee — fine for development, not for
# real users. Get keys from Alchemy, Infura or QuickNode.
# EVM_RPC_ETHEREUM=
# EVM_RPC_BASE=
# EVM_RPC_ARBITRUM=
# EVM_RPC_OPTIMISM=
# EVM_RPC_POLYGON=

# --- Deposits and withdrawals ------------------------------------------------
# There is nothing to configure here, by design.
#
# The platform runs a centralised model: the business holds the receiving
# accounts (an exchange account, for instance), an operator records those
# addresses under /admin/deposit-addresses and assigns them to users, credits
# deposits from /admin/deposits once confirmed, and pays withdrawals by hand
# from /admin/withdrawals.
#
# No third-party custodian is involved, so there are no API keys, no private
# keys and no adapter to select. The trade-off is that crediting a deposit and
# paying a withdrawal are human steps — every one of them recorded in the audit
# log with the operator, the amount and the destination.

# Shared secret for the scheduled market-refresh endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=
